# Copy to .env and fill in.  `docker compose up -d` reads it automatically.

# Telegram credentials.
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Comma-separated chat IDs allowed to use the bot (private chats are user IDs).
ALLOWED_CHATS=123456789

# A remote that exists in the rclone.conf below, e.g. "gdrive:media".
RCLONE_REMOTE=gdrive:media

# Where the init container reads the rclone config from on the host.
RCLONE_CONFIG_FILE=./rclone.conf

# Optional tuning; the defaults match the bot's own.  LOG_FILE is set to the
# tgbridge-logs volume by compose.yaml, so only change it if you bypass compose.
# AUTO_MIRROR=false
# MAX_CONCURRENT=2
# LOG_LEVEL=INFO
# GD_DIR_TEMPLATE=%Y-%m-%d
